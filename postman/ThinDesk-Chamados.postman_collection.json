{
  "info": {
    "name": "ThinDesk - Chamados",
    "description": "Fluxo da API de chamados. Envie primeiro a requisi��o Entrar; o Postman guarda o cookie de sess�o do login existente. O nome de usu�rio autenticado � registrado como solicitante e � usado no endpoint /usuario/{id}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "thindesk" },
    { "key": "chamadoId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Entrar",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "username", "value": "{{username}}", "type": "text" },
            { "key": "password", "value": "{{password}}", "type": "text" }
          ]
        },
        "url": "{{baseUrl}}/login",
        "description": "Autentica com o login j� existente no ThinDesk. O cookie JSESSIONID � reutilizado pelas pr�ximas requisi��es."
      }
    },
    {
      "name": "2. Abrir chamado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Chamado aberto e persistido', function () {",
              "    pm.response.to.have.status(201);",
              "    const chamado = pm.response.json();",
              "    pm.expect(chamado.status).to.eql('ABERTO');",
              "    pm.expect(chamado.solicitante).to.eql(pm.collectionVariables.get('username'));",
              "    pm.expect(chamado.dataAbertura).to.be.a('string');",
              "    pm.collectionVariables.set('chamadoId', chamado.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Computador sem acesso � rede\",\n  \"descricao\": \"A esta��o do setor financeiro n�o consegue acessar a rede.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/chamados",
        "description": "O solicitante, a data de abertura e o status s�o definidos pelo servi�o."
      }
    },
    {
      "name": "3. Listar chamados do usu�rio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Chamado aparece na lista persistida do solicitante', function () {",
              "    pm.response.to.have.status(200);",
              "    const chamados = pm.response.json();",
              "    pm.expect(chamados.some(chamado => chamado.id === pm.collectionVariables.get('chamadoId'))).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/chamados/usuario/{{username}}"
      }
    },
    {
      "name": "4. Consultar chamado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Detalhes do chamado aberto est�o persistidos', function () {",
              "    pm.response.to.have.status(200);",
              "    const chamado = pm.response.json();",
              "    pm.expect(chamado.id).to.eql(pm.collectionVariables.get('chamadoId'));",
              "    pm.expect(chamado.status).to.eql('ABERTO');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/chamados/{{chamadoId}}"
      }
    },
    {
      "name": "5. Resolver chamado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Chamado resolvido com solu��o e data', function () {",
              "    pm.response.to.have.status(200);",
              "    const chamado = pm.response.json();",
              "    pm.expect(chamado.status).to.eql('RESOLVIDO');",
              "    pm.expect(chamado.solucao).to.be.a('string').and.not.empty;",
              "    pm.expect(chamado.tecnico).to.eql(pm.collectionVariables.get('username'));",
              "    pm.expect(chamado.dataResolucao).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solucao\": \"Reiniciada a interface de rede e validado o acesso.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/chamados/{{chamadoId}}/resolver"
      }
    },
    {
      "name": "6. Confirmar resolu��o persistida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A consulta retorna o estado salvo no MongoDB', function () {",
              "    pm.response.to.have.status(200);",
              "    const chamado = pm.response.json();",
              "    pm.expect(chamado.status).to.eql('RESOLVIDO');",
              "    pm.expect(chamado.solucao).to.eql('Reiniciada a interface de rede e validado o acesso.');",
              "    pm.expect(chamado.dataResolucao).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/chamados/{{chamadoId}}"
      }
    },
    {
      "name": "7. Bloquear nova resolu��o",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Chamado resolvido n�o pode ser alterado novamente', function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solucao\": \"Tentativa de alterar ap�s resolu��o.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/chamados/{{chamadoId}}/resolver"
      }
    }
  ]
}
